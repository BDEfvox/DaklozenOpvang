 "vanderlinden:2642": {
  "best_tier": "great",
  "first_seen": "2026-11-10T13:14:32Z",
  "flags": [],
  "last_seen": "2026-11-10T13:14:32Z",
  "listing": {
   "address": "Bert Haanstrakade 880",
   "area_m2": 73,
   "available_from": null,
   "available_until": null,
   "bedrooms": null,
