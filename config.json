  "_income_patterns": "Regexes on the lowercased title + description; any hit sets the income_requirement flag, next to the plain phrases in flags.income_requirement. A multiple of the rent counts on its own only from 2.5x up, or next to a word about income: a deposit is worded the same way ('borg 2x de huur') but is at most 2 months.",
  "income_patterns": [
    "\\binkomens-?\\s?(?:eis|vereiste|norm|richtlijn|toets|voorwaarde|criteri|grens|check|verklaring)",
    "\\b(?:bruto|netto)[- ]?(?:maand|jaar)?[- ]?(?:inkomen|salaris|loon)",
    "\\b(?:minimaal|minimum|minimale|vast|vaste|stabiel|voldoende|aantoonbaar|gezamenlijk)\\s+(?:bruto\\s+|netto\\s+)?(?:maand|jaar)?(?:inkomen|salaris)",
    "\\b(?:loonstro(?:ok|ken)|salarisstro(?:ok|ken)|werkgeversverklaring|payslips?|pay slips?|salary slips?|employer'?s statement)\\b",
    "\\bincome\\s+(?:requirement|guideline|criteri|check|verification|statement|test|norm|proof)",
    "\\bproof of (?:sufficient |stable |steady |regular )?(?:income|earnings)\\b",
    "\\b(?:gross|net|minimum|minimal|sufficient|stable|steady|regular|monthly|annual|yearly|combined)\\s+(?:gross\\s+|net\\s+)?(?:monthly\\s+|annual\\s+|yearly\\s+)?(?:income|salary)\\b",
    "\\b(?:inkom|salaris|verdien|bruto|income|salary|earn|gross)\\w*\\W.{0,100}?\\d\\s*(?:x|×|keer|maal|times)\\b",
    "\\d\\s*(?:x|×|keer|maal|times)\\s.{0,80}?\\b(?:inkom|salaris|verdien|bruto|income|salary|earn|gross)",
    "(?<![\\d.,])(?:2[.,]5|[3-9](?:[.,]\\d)?|[1-9]\\d)\\s*(?:x|×|keer|maal|times)\\s+(?:keer\\s+)?(?:(?:de|het|the|your|je|uw|jouw)\\s+)?(?:\\w+\\s+){0,2}?(?:(?:maand)?huur|rent)"
  ],
  "max_persons_patterns": [
    "max(?:imaal|\\.)?\\s?(\\d)\\s?(?:personen|persons|people)",
    "geschikt voor (\\d) (?:personen|persoons)",
    "max (\\d) persons",
    "suitable for (\\d) (?:people|persons)",
    "\\bmax(?:imaal|imum|\\.)?\\s?(\\d)\\s+(?:werkende\\s+)?(?:woningdelers|delers|bewoners|huurders|studenten|volwassenen|sharers|tenants|occupants|adults|students)\\b",
    "\\b(?:up to|maximum of|max\\. of)\\s+(\\d)\\s+(?:people|persons|tenants|occupants|adults|sharers)\\b"
  ],
  "couple_patterns": [
    "alleen voor (?:een )?stel",
    "uitsluitend voor (?:een )?stel",
    "couple only",
    "only for (?:a )?couple",
    "\\bsingle\\s+person\\s+or\\s+(?:a\\s+)?couple\\b",
    "\\balleenstaande\\s+of\\s+(?:een\\s+)?stel\\b",
    "\\b1\\s+of\\s+2\\s+personen\\b"
  ],
  "_single_patterns": "One-person wording. The bare word 'single' is not enough (single bed, single-family home). When one of these is offered next to a couple ('alleenstaande of stel', 'single person or a couple') the code reads it as a two-person limit.",
  "single_patterns": [
    "\\bsingle\\s+occupancy\\b",
    "\\bsingle\\s+(?:person|tenant|occupant)\\s+only\\b",
    "\\bfor\\s+(?:a|one)\\s+single\\s+person\\b",
    "\\b(?:one|1)\\s+person\\s+only\\b",
    "\\b(?:one|1)[- ]person\\s+household\\b",
    "\\balleenstaanden?\\b(?!\\s+(?:woning|huis|villa|bungalow|garage))",
    "\\beenpersoonshuishoudens?\\b",
    "\\bvoor\\s+(?:een|\u00e9\u00e9n)\\s+persoon\\b",
    "\\b(?:geschikt|bedoeld|alleen|uitsluitend|max(?:imaal|\\.)?)\\s+(?:voor\\s+)?1\\s+persoon\\b",
    "\\bmax(?:imaal|imum|\\.)?\\s*1\\s+(?:werkende?\\s+|working\\s+)(?:persoon|person)\\b"
  ],
  "_tenant_rules": "Extra regexes (on the lowercased title + description) for the 'who may rent' flags, added to the built-in ones in hunter/tenancy.py: students_only, no_students, students_ok, working_only, no_sharers, sharers_ok, housemates. 'age' takes [pattern, kind] pairs, kind = min | max | range.",
  "tenant_rules": {},
  "_household": "Who is looking. Leave both null to be alerted about every home. With an age (a number: for a group, the youngest) and/or an occupation ('students' or 'working'), homes whose own text or fields exclude you (minimum or maximum age, students only, no students, working people only) are no longer matched or alerted. A home that says nothing about this always stays.",
